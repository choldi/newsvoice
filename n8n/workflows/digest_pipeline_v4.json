{
  "name": "digest_pipeline_v4",
  "version": 4,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hours": 8
            }
          ]
        }
      },
      "name": "Schedule 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [200, 200]
    },
    {
      "parameters": {
        "url": "http://api:8000/api/filter_new",
        "options": {}
      },
      "name": "POST /filter_new",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [400, 200]
    },
    {
      "parameters": {
        "url": "http://api:8000/api/cluster",
        "options": {}
      },
      "name": "POST /cluster",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [600, 200]
    },
    {
      "parameters": {
        "url": "http://api:8000/api/summarize",
        "options": {}
      },
      "name": "POST /summarize",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [800, 200]
    },
    {
      "parameters": {
        "url": "http://api:8000/api/generate_tts",
        "options": {}
      },
      "name": "POST /generate_tts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [800, 400]
    },
    {
      "parameters": {
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "={{$json[\"markdown\"]}}",
        "additionalFields": {}
      },
      "name": "Telegram Text",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1000, 200]
    },
    {
      "parameters": {
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "file": "={{$json[\"audio_path\"]}}",
        "additionalFields": {
          "caption": "🎧 Audio digest"
        }
      },
      "name": "Telegram Audio",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1000, 400]
    }
  ],
  "connections": {
    "Schedule 08:00": {
      "main": [[{"node": "POST /filter_new", "type": "main", "index": 0}]]
    },
    "POST /filter_new": {
      "main": [[{"node": "POST /cluster", "type": "main", "index": 0}]]
    },
    "POST /cluster": {
      "main": [[{"node": "POST /summarize", "type": "main", "index": 0}]]
    },
    "POST /summarize": {
      "main": [
        [
          {"node": "Telegram Text", "type": "main", "index": 0},
          {"node": "POST /generate_tts", "type": "main", "index": 0}
        ]
      ]
    },
    "POST /generate_tts": {
      "main": [[{"node": "Telegram Audio", "type": "main", "index": 0}]]
    }
  }
}
