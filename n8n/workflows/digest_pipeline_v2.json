{
  "name": "Phase 2 - Deduplicated Daily News Digest Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "node-schedule-trigger",
      "name": "Schedule Trigger (08:00 AM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://feeds.bbci.co.uk/news/world/rss.xml"
      },
      "id": "node-rss-feed",
      "name": "Fetch RSS Feed",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst articles = items.map(item => ({\n  title: item.json.title || '',\n  link: item.json.link || '',\n  content: item.json.contentSnippet || item.json.content || '',\n  pub_date: item.json.pubDate || item.json.isoDate || '',\n  source: 'BBC News'\n}));\n\nreturn [{ json: { articles } }];"
      },
      "id": "node-format-payload",
      "name": "Format Articles Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/filter_new",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "node-http-filter-new",
      "name": "POST /filter_new API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        800,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.new_count }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "node-if-new-articles",
      "name": "IF New Articles Found",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1000,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { articles: $input.first().json.new_articles } }];"
      },
      "id": "node-prepare-summarize",
      "name": "Prepare Summarize Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        250
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/summarize",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "node-http-summarize-api",
      "name": "POST /summarize API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1400,
        250
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.digest }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "node-telegram-send",
      "name": "Send Telegram Message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [
        1600,
        250
      ]
    }
  ],
  "connections": {
    "Schedule Trigger (08:00 AM)": {
      "main": [
        [
          {
            "node": "Fetch RSS Feed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch RSS Feed": {
      "main": [
        [
          {
            "node": "Format Articles Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Articles Payload": {
      "main": [
        [
          {
            "node": "POST /filter_new API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /filter_new API": {
      "main": [
        [
          {
            "node": "IF New Articles Found",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF New Articles Found": {
      "main": [
        [
          {
            "node": "Prepare Summarize Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Summarize Payload": {
      "main": [
        [
          {
            "node": "POST /summarize API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /summarize API": {
      "main": [
        [
          {
            "node": "Send Telegram Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
