{
  "name": "Phase 1 - Daily News Digest MVP",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "node-schedule-trigger",
      "name": "Schedule Trigger (08:00 AM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://feeds.bbci.co.uk/news/world/rss.xml"
      },
      "id": "node-rss-feed",
      "name": "Fetch RSS Feed",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst articles = items.map(item => ({\n  title: item.json.title || '',\n  link: item.json.link || '',\n  content: item.json.contentSnippet || item.json.content || '',\n  pub_date: item.json.pubDate || item.json.isoDate || '',\n  source: 'BBC News'\n}));\n\nreturn [{ json: { articles } }];"
      },
      "id": "node-format-payload",
      "name": "Format Articles Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/mvp_digest",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "node-http-digest-api",
      "name": "POST /mvp_digest API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.digest }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "node-telegram-send",
      "name": "Send Telegram Message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [
        1050,
        300
      ]
    }
  ],
  "connections": {
    "Schedule Trigger (08:00 AM)": {
      "main": [
        [
          {
            "node": "Fetch RSS Feed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch RSS Feed": {
      "main": [
        [
          {
            "node": "Format Articles Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Articles Payload": {
      "main": [
        [
          {
            "node": "POST /mvp_digest API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /mvp_digest API": {
      "main": [
        [
          {
            "node": "Send Telegram Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
