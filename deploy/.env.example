# =============================================================================
# newsvoice — compose-level variables
# =============================================================================
# Copy to `deploy/.env`. This file is ONLY for variable interpolation inside
# deploy/docker-compose*.yml. The containers get their own variables from the
# per-app files (kept separate on purpose — both apps define VOICES_DIR with
# different meanings/paths):
#   apps/news/.env     <- copied from apps/news/.env.example
#   apps/gateway/.env  <- copied from apps/gateway/.env.example
# =============================================================================

# --- Published ports ---
# news-engine API (kept at 8000 to match the existing deployment)
API_PORT=8000
# TTS gateway. The container listens on 8000 and is published here as 8001 for
# host/external access. Shape A container DNS uses the internal port:
# TTS_API_BASE_URL=http://gateway:8000/api/v1 (the GET /disk probe follows it).
GATEWAY_PORT=8001

# --- Paths ---
# Host path to the external OmniVoice installation, mounted read-only into the
# gateway at /omnivoice-external (what TTS_INSTALL_DIR points at).
TTS_PATH=/opt/omnivoice

# --- qwen3_tts on-prem (only meaningful with the GPU overlay) ---
# The qwen-tts runtime lives in an external venv built on the host against
# /usr/bin/python3.13, so the venv, that interpreter, its stdlib and
# libpython3.13.so must all be mounted at the paths the venv symlinks resolve
# to. Use `docker compose -f deploy/docker-compose.yml -f deploy/docker-compose.gpu.yml`
# to enable GPU access; without the overlay qwen3_tts has no GPU and stays
# unavailable.
# Host directory holding the qwen3 venv "$QWEN3_TTS_DIR/venv/bin/python".
QWEN3_TTS_DIR=/opt/qwen3-tts
# Host interpreter the venv was created against.
QWEN3_TTS_HOST_PYTHON=/usr/bin/python3.13
# Host stdlib directory for that interpreter.
QWEN3_TTS_HOST_STDLIB=/usr/lib/python3.13
# Host include directory (Python.h) for that interpreter; Triton compiles a
# CUDA driver shim against it on first synthesis.
QWEN3_TTS_HOST_INCLUDE=/usr/include/python3.13
# Host architecture include directory (multiarch Python.h) for that interpreter.
QWEN3_TTS_HOST_ARCH_INCLUDE=/usr/include/x86_64-linux-gnu/python3.13
# Host libpython3.13 shared library for that interpreter.
QWEN3_TTS_HOST_LIBPYTHON=/usr/lib/x86_64-linux-gnu/libpython3.13.so.1.0
# Host HuggingFace cache (holds the three Qwen3-TTS checkpoints).
QWEN3_TTS_HF_CACHE=/home/jordi/.cache/huggingface

# --- Shape selection (only affects the split overlay) ---
# Shape A (single host, default): leave as-is.
# Shape B app host:   COMPOSE_PROFILES=news
# Shape B GPU host:   COMPOSE_PROFILES=gateway
COMPOSE_PROFILES=news,gateway

# --- Required in apps/news/.env for Shape A (container DNS, not Tailscale) ---
#   TTS_API_BASE_URL=http://gateway:8000/api/v1
#   NARRATION_API_BASE_URL=            # empty reuses TTS_API_BASE_URL
# --- Required in apps/gateway/.env ---
#   TTS_ENGINE=routed
#   TTS_ENGINES={"es":"pocket_tts","en":"pocket_tts","fr":"pocket_tts","ca":"edgetts","_default":"pocket_tts"}
#   TTS_EXTRA_ENGINES=kokoro,qwen3_tts,omnivoice_remote  # pins explícitos de engine
#   TTS_DEVICE=cuda:0
#   API_KEY=                           # set to protect the gateway API
