# =============================================================================
# newsvoice — compose-level variables
# =============================================================================
# Copy to `deploy/.env`. This file is ONLY for variable interpolation inside
# deploy/docker-compose*.yml. The containers get their own variables from the
# per-app files (kept separate on purpose — both apps define VOICES_DIR with
# different meanings/paths):
#   apps/news/.env     <- copied from apps/news/.env.example
#   apps/gateway/.env  <- copied from apps/gateway/.env.example
# =============================================================================

# --- Published ports ---
# news-engine API (kept at 8000 to match the existing deployment)
API_PORT=8000
# TTS gateway. The container listens on 8000 and is published here as 8001 for
# host/external access. Shape A container DNS uses the internal port:
# TTS_API_BASE_URL=http://gateway:8000/api/v1 (the GET /disk probe follows it).
GATEWAY_PORT=8001
# Shared key for the TTS gateway's X-API-Key auth. Generate with
# `openssl rand -hex 32` and mirror the same value into apps/news/.env as
# TTS_API_KEY (and NARRATION_API_KEY if it is set separately). Empty leaves the
# gateway open, which is only acceptable on a trusted host.
GATEWAY_API_KEY=

# --- qwen3_tts sidecar (self-contained) ---
# The "qwen3" compose profile runs apps/gateway/Dockerfile.qwen3; torch and
# qwen-tts live inside that image and its weights persist in qwen3_hf_cache.
# Start it with QWEN3=1 ./scripts/deploy.sh (plus GPU=1) or manually:
#   docker compose --profile qwen3 up -d gateway-qwen3
# Point the main gateway at it; the public engine name stays qwen3_tts.
#   QWEN3_TTS_REMOTE_URL=http://gateway-qwen3:8000/api/v1
# `QWEN3=1 ./scripts/deploy.sh` exports this value for that compose invocation
# only. There is no host-venv fallback: torch and qwen-tts live only in the
# sidecar image.
QWEN3_TTS_REMOTE_URL=

# --- OmniVoice sidecar ---
# The "omnivoice" profile runs gateway-omnivoice with the OmniVoice runtime.
# Start it with OMNIVOICE=1 ./scripts/deploy.sh (plus GPU=1), or start both
# sidecars at once with SIDECARS=1 (adds the GPU overlay automatically):
#   SIDECARS=1 ./scripts/deploy.sh production
# deploy.sh injects the internal default when this is empty; set it only to
# override the URL the gateway uses.
OMNIVOICE_REMOTE_URL=

# --- Shape selection (only affects the split overlay) ---
# Shape A (single host, default): leave as-is.
# Shape B app host:   COMPOSE_PROFILES=news
# Shape B GPU host:   COMPOSE_PROFILES=gateway
COMPOSE_PROFILES=news,gateway

# --- Required in apps/news/.env for Shape A (container DNS, not Tailscale) ---
#   TTS_API_BASE_URL=http://gateway:8000/api/v1
#   NARRATION_API_BASE_URL=            # empty reuses TTS_API_BASE_URL
# --- Required in apps/gateway/.env ---
#   TTS_ENGINE=routed
#   TTS_ENGINES={"es":"pocket_tts","en":"pocket_tts","fr":"pocket_tts","ca":"edgetts","_default":"pocket_tts"}
#   TTS_EXTRA_ENGINES=kokoro,qwen3_tts,omnivoice_remote  # pins explícitos de engine
#   TTS_DEVICE=cuda:0
#   API_KEY=                           # set to protect the gateway API
