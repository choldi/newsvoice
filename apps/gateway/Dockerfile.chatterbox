# Chatterbox sidecar image.
#
# chatterbox-tts pins numpy<2, which cannot coexist with pocket_tts (numpy>=2)
# in the main gateway virtualenv. This image runs the same tts_api app with
# TTS_ENGINE=chatterbox and a dedicated venv holding chatterbox-tts; the main
# gateway reaches it over HTTP through the chatterbox proxy engine
# (CHATTERBOX_REMOTE_URL) while keeping the public engine name `chatterbox`.
FROM python:3.12-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./
COPY libs/tts_contract ./libs/tts_contract
COPY apps/gateway/pyproject.toml apps/gateway/README.md ./apps/gateway/
RUN pip install --no-cache-dir uv && \
    uv sync --frozen --no-dev --no-install-project --package tts-api && \
    uv cache clean

COPY apps/gateway/tts_api ./apps/gateway/tts_api
COPY apps/gateway/voice_profiles.json ./voice_profiles.json
COPY config/engines.toml ./config/engines.toml
RUN uv sync --frozen --no-dev --package tts-api && \
    uv pip install --python /app/.venv/bin/python --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu124 \
        "torch==2.6.0" "torchaudio==2.6.0" && \
    uv pip install --python /app/.venv/bin/python --no-cache-dir \
        "numpy<2" "chatterbox-tts"

FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade "setuptools>=84.2.1"

WORKDIR /app

COPY --from=builder /app /app

ENV VIRTUAL_ENV=/app/.venv
ENV PATH="/app/.venv/bin:${PATH}"
ENV TTS_ENGINE=chatterbox
ENV TTS_ENGINES=
ENV TTS_EXTRA_ENGINES=
ENV CHATTERBOX_REMOTE_URL=
ENV HF_HOME=/root/.cache/huggingface
ENV TTS_FALLBACK_TO_MOCK=false

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD python -c "import httpx; r=httpx.get('http://localhost:8000/api/v1/health'); exit(0 if r.status_code==200 else 1)"

CMD ["uvicorn", "tts_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
