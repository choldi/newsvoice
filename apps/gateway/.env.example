# =============================================================================
# TTS API — Variables de entorno (multi-engine)
# =============================================================================
# Copia este archivo a `.env` y ajusta los valores según tu entorno.
# Los tipos y valores por defecto están definidos en `tts_api/settings.py`.
#
# Engines disponibles:
#   omnivoice  - GPU, full features (stock, clone, instruct, emotions)
#   pocket_tts - CPU, voice cloning, es/en/fr (no Catalan)
#   edgetts    - Cloud, no cloning, 400+ voices including Catalan (ca-ES)
#   kokoro     - CPU, stock voices (es/en/fr/it/pt/hi, sin Catalan)
#   qwen3_tts  - GPU (sidecar self-contained), clonado de voces del catálogo
#   mock       - Test tones (development/testing)
# Recomendado: TTS_ENGINE=routed + TTS_EXTRA_ENGINES (ver abajo).
# =============================================================================


# ============================================================================
# TTS ENGINE SELECTION (la variable más importante)
# ============================================================================

# Engine a usar: omnivoice, pocket_tts, edgetts, kokoro, mock, routed
TTS_ENGINE=routed

# Multi-engine routing (when TTS_ENGINE=routed)
# JSON dict: language_code -> engine_name. Use "_default" for fallback.
# Ejemplo: Pocket TTS para es/en/fr + EdgeTTS para ca (Catalan)
TTS_ENGINES={"es":"pocket_tts","en":"pocket_tts","fr":"pocket_tts","ca":"edgetts","_default":"pocket_tts"}

# Engines cargados además del enrutado, para pins explícitos de engine
# (`engine=kokoro`, `engine=qwen3_tts`, voces clonadas con omnivoice_remote).
# Solo tienen efecto con TTS_ENGINE=routed (el factory los instancia aquí).
# kokoro: CPU, dependencias horneadas en la imagen del gateway.
# qwen3_tts: sidecar (GPU); no-fatal si no corre → engine "unavailable".
# omnivoice_remote: sidecar (perfil "omnivoice"); no-fatal si no corre.
TTS_EXTRA_ENGINES=kokoro,qwen3_tts,omnivoice_remote


# ============================================================================
# ENGINE-SPECIFIC CONFIG
# ============================================================================

# --- Pocket TTS (when TTS_ENGINE=pocket_tts) ---
# Idioma por defecto (ISO 639-1) cuyo checkpoint se carga al arrancar; los
# demás idiomas se cargan de forma perezosa. No se carga el modelo inglés si
# nadie pide inglés.
POCKET_TTS_DEFAULT_LANGUAGE=es
# Override global del checkpoint: ruta/URL de un config YAML
# ("hf://<repo>/config.yaml"). Vacío = checkpoint por idioma (recomendado).
POCKET_TTS_MODEL=
# Prompts de referencia (WAV) para las voces stock ES/FR clonadas, en JSON:
# {"es_male": "/ruta/es_male.wav", "fr_female": "/ruta/fr_female.wav"}.
POCKET_TTS_REFERENCES=

# --- EdgeTTS (when TTS_ENGINE=edgetts) ---
# Locale por defecto para el mapeo de voces stock
EDGETTS_VOICE_PREFIX=es-MX

# --- Kokoro (TTS_ENGINE=kokoro, or pinned via routed + TTS_EXTRA_ENGINES) ---
# Repo Hugging Face del model card oficial (82M params).
KOKORO_REPO_ID=hexgrad/Kokoro-82M
# Idioma por defecto (ISO 639-1) -> lang_code de una letra del KPipeline.
# Kokoro no soporta catalán.
KOKORO_DEFAULT_LANGUAGE=es
# Override del mapeo voz_id -> voz nativa de Kokoro, en JSON:
# {"es-mx-female": "ef_dora", "en-us-male": "am_michael"}.
KOKORO_VOICES=

# --- Qwen3-TTS (when TTS_ENGINE=qwen3_tts, or pinned per voice via routed) ---
# Run the self-contained `gateway-qwen3` sidecar (Dockerfile.qwen3) and point
# the gateway at it. The public engine name stays qwen3_tts. The sidecar image
# also sets QWEN3_TTS_PYTHON to its internal venv; do not mount a host venv.
#   QWEN3_TTS_REMOTE_URL=http://gateway-qwen3:8000/api/v1
# Without the sidecar the engine stays unavailable and its voices fall back to
# Edge.
QWEN3_TTS_REMOTE_URL=
QWEN3_TTS_REMOTE_TIMEOUT=300
# Device / dtype / attention implementation for the three models.
QWEN3_TTS_DEVICE=cuda:0
QWEN3_TTS_DTYPE=bfloat16
QWEN3_TTS_ATTN=sdpa
# Hugging Face repos for each model kind (CustomVoice = stock, VoiceDesign,
# Base = voice cloning).
QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
QWEN3_TTS_DESIGN_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
QWEN3_TTS_CLONE_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base

# ============================================================================
# HUGGINGFACE (pocket_tts voice cloning)
# ============================================================================
# Token de HuggingFace necesario para descargar los pesos gated de
# `kyutai/pocket-tts` que usa el clonado de voz de pocket_tts. Requiere haber
# aceptado los términos del repo en https://huggingface.co/kyutai/pocket-tts.
# Sin este token, el clonado falla (las voces stock no lo necesitan).
# Obtén el token con `hf auth login` (se guarda en ~/.cache/huggingface/token).
HF_TOKEN=

# Alternativa: ruta al fichero de token montado en el contenedor
# (huggingface_hub también lee HF_TOKEN_FILE si está definido)
HF_TOKEN_FILE=


# ============================================================================
# OMNIVOICE CONFIG (when TTS_ENGINE=omnivoice)
# ============================================================================

# Solo para desarrollo local fuera de Docker. El compose fija
# TTS_INSTALL_DIR=/app y TTS_VENV_DIR=/app/.venv para el sidecar.
TTS_INSTALL_DIR=

# Solo para desarrollo local fuera de Docker.
TTS_VENV_DIR=

# Ruta al modelo de OmniVoice
# Si se deja vacío, se deriva como: ${TTS_INSTALL_DIR}/models
TTS_MODEL_PATH=

# Dispositivo de inferencia (cuda:0, cpu, etc.)
TTS_DEVICE=cuda:0

# Mock / Real engine toggle (legacy, now use TTS_ENGINE=mock instead)
TTS_USE_MOCK=false
TTS_FALLBACK_TO_MOCK=true

# --- OmniVoice sidecar (when TTS_ENGINE=omnivoice_remote) ---
# The main gateway proxies to a separate `gateway-omnivoice` container to keep
# the real OmniVoice deps (librosa/numba, transformers>=5.3) isolated from
# pocket_tts (numpy>=2). Point this at the sidecar's internal address and pin
# the engine in TTS_ENGINES (e.g. {"en":"omnivoice_remote"}). Leave empty to
# keep the proxy disabled (it starts but stays unavailable).
OMNIVOICE_REMOTE_URL=http://gateway-omnivoice:8000
OMNIVOICE_REMOTE_TIMEOUT=300

# --- Fish Audio (when TTS_ENGINE=fish_tts or pinned via routed) ---
# Cloud provider. Empty FISH_API_KEY disables it in routed mode.
FISH_API_BASE_URL=https://api.fish.audio
FISH_API_KEY=
FISH_MODEL=s2.1-pro-free
FISH_SAMPLE_RATE=24000
FISH_TIMEOUT=300
FISH_USE_INLINE_REFERENCES=true
# Optional stock voices: {"es_fish": {"reference_id": "...", "language": "es"}}
FISH_VOICES=
FISH_LANGUAGES=es,en,fr,de,it,pt,zh,ja,ko

# --- OpenAI-compatible TTS (when TTS_ENGINE=openai_tts or pinned via routed) ---
# Base URL must include the API version; leave empty to disable.
OPENAI_TTS_BASE_URL=
OPENAI_TTS_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_TIMEOUT=120
# {"es_openai": {"voice": "alloy", "language": "es"}}
OPENAI_TTS_VOICES=
OPENAI_TTS_LANGUAGES=es,en


# ============================================================================
# DATABASE
# ============================================================================

DATABASE_URL=sqlite:///storage/omnivoice.db


# ============================================================================
# OPTIONAL VARIABLES
# ============================================================================

# --- App ---
APP_NAME=TTS API                                  # Valor por defecto: "TTS API"
APP_VERSION=0.2.0                                 # Valor por defecto: "0.2.0"
DEBUG=false                                        # Valor por defecto: false
API_PREFIX=/api/v1                                 # Valor por defecto: "/api/v1"

# --- Storage ---
STORAGE_BASE_PATH=storage                          # Valor por defecto: "storage"
VOICES_DIR=storage/voices                          # Valor por defecto: "storage/voices"
OUTPUTS_DIR=storage/outputs                        # Valor por defecto: "storage/outputs"
CACHE_DIR=storage/cache                            # Valor por defecto: "storage/cache"
OUTPUT_TTL_SECONDS=3600                            # Valor por defecto: 3600

# --- Catálogo de voces (propiedad del gateway; news-engine lo lee por HTTP) ---
VOICE_PROFILES_FILE=voice_profiles.json            # Valor por defecto: "voice_profiles.json"
VOICE_CATALOG_DIR=storage/voice_catalog            # Valor por defecto: "storage/voice_catalog"

# --- Security ---
API_KEY=                                           # Valor por defecto: "" (desactivado)
CORS_ORIGINS=*                                     # Valor por defecto: "*"
MAX_UPLOAD_SIZE_MB=10                              # Valor por defecto: 10
MAX_REFERENCE_DURATION_SEC=30                      # Valor por defecto: 30

# --- Observabilidad ---
LOG_LEVEL=INFO                                     # Valor por defecto: "INFO"
LOG_FORMAT=json                                    # Valor por defecto: "json"
