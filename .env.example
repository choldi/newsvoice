# Environment Configuration Example
# Copy to .env for local development

# LLM Configuration (LiteLLM)
LLM_API_BASE=http://host.docker.internal:8080/v1
LLM_MODEL=openai/local-model
LLM_TEMPERATURE=0.3
# Timeout (seconds) for a single LLM call; raise for slow local inference (llama.cpp)
LLM_TIMEOUT_SECONDS=1800
# Upper bound on generated tokens (guards against runaway reasoning models)
LLM_MAX_TOKENS=4096
# Disable thinking/reasoning for Qwen3-style models served by llama.cpp so the
# final answer lands in `content` (otherwise it only fills reasoning_content)
LLM_DISABLE_THINKING=true

# --- LLM verification (Phase 7.13) ---
# Global kill switch. Verification is still opt-in per collection via
# `llm_verify = true` in collections.toml; this flag can only turn it off for
# every collection at once.
# LLM_VERIFY_ENABLED=true
# Faithfulness score (supported claims / total claims) a digest must reach to be
# delivered. Calibrate against known-good digests before tightening (Deploy.md 11.4).
# LLM_VERIFY_THRESHOLD=0.9
# Share of numbers/dates/percentages that must exist verbatim in a source
# article. No LLM involved, so 1.0: a fabricated figure is the failure worth
# blocking on.
# LLM_VERIFY_GROUNDEDNESS_THRESHOLD=1.0
# Judge backend: local (LLM_API_BASE), modal (GPU judge) or api (hosted provider).
# LLM_VERIFY_BACKEND=local
# Judge model. Empty = LLM_MODEL for 'local', MODAL_JUDGE_MODEL for 'modal',
# the provider default for 'api'.
# LLM_VERIFY_MODEL=
# Endpoint and key for the 'api' backend. API_BASE empty reuses LLM_API_BASE,
# which usually points at your local llama.cpp: set it to move only the judge
# to a hosted provider. The key is never logged.
# LLM_VERIFY_API_BASE=
# LLM_VERIFY_API_KEY=
# Judge batching. A digest shorter than MIN_CLAIMS is scored on groundedness
# alone; at most MAX_CLAIMS are judged, CLAIMS_PER_CALL per LLM call.
# LLM_VERIFY_MIN_CLAIMS=3
# LLM_VERIFY_MAX_CLAIMS=40
# LLM_VERIFY_CLAIMS_PER_CALL=5
# Sources and per-source text handed to the judge (groundedness always sees all).
# LLM_VERIFY_MAX_SOURCES=40
# LLM_VERIFY_SOURCE_CHARS=1200
# Per-source reliability. A feed without an explicit value scores the default;
# a feed below MIN_SOURCE_RELIABILITY is dropped BEFORE clustering, so it cannot
# influence the digest at all. Set per feed with inline tables in collections.toml:
#   feed_urls = [ { url = "https://news.google.com/rss", reliability = 0.6,
#                   hosts = ["bbc.co.uk"] } ]
# SOURCE_RELIABILITY_DEFAULT=1.0
# MIN_SOURCE_RELIABILITY=0.5

# --- Single-URL summary (Phase 7.10) ---
# Kill switch for POST /api/summarize/url. The endpoint is always behind the
# admin auth; this closes it without a code change.
# URL_SUMMARY_ENABLED=true
# Timeout (seconds) for downloading the article page.
# URL_FETCH_TIMEOUT=30
# Refuse any response larger than this (bytes); the body is all we need.
# URL_FETCH_MAX_BYTES=5000000
# Body characters handed to the prompt; longer articles are truncated with a
# visible marker instead of being silently cut.
# URL_SUMMARY_MAX_CHARS=12000

# --- Long-document TTS (Phase 7.11) ---
# Kill switch for POST /api/admin/documents/tts (always behind the admin auth).
# DOC_TTS_ENABLED=true
# Dedicated task queue served by the doc-tts-worker compose service.
# DOC_TTS_TASK_QUEUE=news-engine-doc-tts-queue
# Upload cap in bytes (the body is rejected with 413 before extraction).
# DOC_TTS_MAX_FILE_BYTES=20000000
# Extracted-text cap in characters (~300 pages). Over it the job fails with an
# explicit error instead of shipping a silently truncated book.
# DOC_TTS_MAX_SOURCE_CHARS=600000
# Characters per edge-tts request; chunks are joined into one MP3.
# DOC_TTS_CHUNK_CHARS=4000
# Chunks synthesized concurrently inside the activity.
# DOC_TTS_CONCURRENCY=4
# Uploads, extracted text, chunk cache and finished audio (shared ./data).
# DOC_TTS_DIR=data/doc_tts
# HMAC key for the shareable audio links (the only auth a pasted link has).
# Generate with: openssl rand -hex 32. Empty = signed links off and the submit
# endpoint answers 503 until you set it.
# DOC_TTS_LINK_SECRET=
# DOC_TTS_LINK_TTL_SECONDS=604800

# Delivery / Notifications
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Email delivery via SMTP (optional, per-collection in collections.toml).
# Gmail relay defaults: smtp.gmail.com:587 with STARTTLS. Use an App Password
# (https://myaccount.google.com/apppasswords), NOT the Gmail login password.
# A collection sends email only when it sets email_recipients in collections.toml.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASSWORD=your_smtp_password_here
MAIL_FROM=your_smtp_user_here
# MAIL_FROM_NAME=News Engine

# WhatsApp delivery via a self-hosted Baileys gateway (docker-compose service
# named "there"; blakegt/whatsapp-web-api-rest on :8085, no auth, keep it off
# the LAN). Fail-closed: while WHATSAPP_API_TOKEN is empty the channel is
# disabled and never blocks a digest. A collection sends WhatsApp only when it
# sets whatsapp_recipients or whatsapp_group_id in collections.toml AND
# delivery_channels includes it. Numbers must be E.164 ("+34612345678") and in
# the allowlist below; groups are always allowed. Pair once via QR: tunnel the
# gateway port and open GET / (see Deploy.md).
WHATSAPP_API_URL=http://there:8085
WHATSAPP_API_TOKEN=
# JSON array of E.164 numbers allowed to receive digests (closed address book).
WHATSAPP_ALLOWLIST=[]
# OpenClaw-style human typing delay between sends: off | natural (800-2500ms)
# | custom (range below).
WHATSAPP_DELAY_MODE=natural
WHATSAPP_DELAY_CUSTOM_MIN_MS=2000
WHATSAPP_DELAY_CUSTOM_MAX_MS=8000
# Typing indicator while 'writing': composing | none.
WHATSAPP_TYPING_INDICATOR=composing
# Minimum cool-down per recipient between consecutive sends (ms).
WHATSAPP_RECIPIENT_COOLDOWN_MS=300

# App Configuration
API_PORT=8000
LOG_LEVEL=INFO
DATABASE_PATH=data/news.db

# TTS Configuration (Edge neural voices via edge-tts — no API key required).
# Handles up to tts_max_chars characters; the MP3 is later transcoded to M4A.
TTS_CACHE_DIR=data/tts_cache
TTS_LANGUAGE=es
TTS_VOICE=es-MX-JorgeNeural
# TTS_LANGUAGE / TTS_VOICE are GLOBAL defaults. Each podcast can override them
# per type via PipelineConfig (or --language/--voice in trigger/schedule).
# Language also instructs the LLM to write the whole digest in that language.
# Any Edge neural ShortName works (see https://learn.microsoft.com/azure/ai-services/speech-service/language-support);
# legacy OmniVoice names like 'es-mx-male' or 'en-gb-female' are mapped automatically.
TTS_MAX_CHARS=5000
# Kill switch for the admin HTTP endpoint POST /api/admin/tts. The Temporal
# activities call the TTS service directly, so false only closes the HTTP
# surface. The former public POST /api/generate_tts always answers 410 Gone.
# TTS_API_ENABLED=true
# Timeout (seconds) for one Edge TTS synthesis call.
# TTS_REQUEST_TIMEOUT=600
# Optional: instruct the LLM to write the digest like a podcaster. Only these
# emotion tags are valid: happy, sad, angry, excited, calm, nervous, whisper, singing
TTS_PODCAST_BEHAVIOR=
# Default podcast name used when a collection has no podcast_name; also passed
# as the audio streaming title for TTS delivery.
# TTS_PODCAST_NAME=Mi Podcast
# Audio is transcoded to M4A (AAC) before delivery (Telegram/WhatsApp/Android/iPhone
# compatible) with ffmpeg, installed in the Docker image. Defaults are fine unless
# you need a different binary location or bitrate.
# FFMPEG_PATH=ffmpeg
# TTS_AUDIO_BITRATE_KBPS=48

# Narration configuration (Phase 7 — multi-speaker audio). Separate namespace
# from TTS_* on purpose: TTS_* talks to Edge directly (except the voices
# catalog), so repointing it would move the GUI's voice list to another server.
# Global kill switch; collections opt in individually (from Phase 7.3).
# NARRATION_ENABLED=false
# TTS gateway that serves the narration cast. Empty = reuse TTS_API_BASE_URL.
# NARRATION_API_BASE_URL=http://debwk.elver-exponential.ts.net:8000/api/v1
# NARRATION_API_KEY=
# Task queue served by the dedicated narration worker.
# NARRATION_TASK_QUEUE=news-engine-narration-task-queue
# Phase 7.9b splits podcast generation by namespace *and* queue. The local
# queue serves the self-hosted gateway; the modal queue serves the GPU backends
# and holds the Modal credentials, so the two scale and restart independently.
# NARRATION_LOCAL_TASK_QUEUE is the queue the narration worker polls and the one
# a local digest dispatches to: keep it equal to NARRATION_TASK_QUEUE.
# NARRATION_LOCAL_TASK_QUEUE=news-engine-narration-task-queue
# NARRATION_MODAL_TASK_QUEUE=news-engine-narration-modal-task-queue
# Runtime voice catalog: profiles are versionable in the repo, generated
# references and the manifest live here and are never committed.
# VOICES_DIR=data/voices
# --- Modal (Phase 7.8) ---
# Kill switch for every Modal call. While false the Modal code path is
# unreachable: no .spawn(), no spend.
# MODAL_ENABLED=false
# MODAL_APP_NAME=news-engine
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# MODAL_VOLUME_NAME=news-engine-voices
# MODAL_GPU=L4
# Qwen3-TTS Base runs in the Modal image (Python 3.12, qwen-tts) and serves the
# render path; VoiceDesign runs on the GPU box (run_voice_worker --role design).
# Judge used by Phase 7.13 when a collection sets llm_verify_backend = "modal".
# MODAL_JUDGE_MODEL=Qwen/Qwen3-8B
# QWEN_TTS_BASE_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# QWEN_TTS_DESIGN_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
# QWEN_TTS_MAX_NEW_TOKENS=2048
# QWEN_TTS_BATCH_SIZE=8
# Only read on the GPU box. sdpa is enough for a batch of short clips and keeps
# the worker off the CUDA runtime.
# QWEN_TTS_DEVICE=cuda:0
# QWEN_TTS_ATTN_IMPLEMENTATION=sdpa
# Audible AI disclosure (EU AI Act Art. 50(4)). Empty text disables it.
# NARRATION_AI_DISCLOSURE_TEXT=Este episodio se ha producido con una voz generada por inteligencia artificial.
# NARRATION_AI_DISCLOSURE_INTERVAL_MINUTES=0
# Hard budget caps. Estimated daily spend is ~$0.10, so the defaults sit 10x
# above it: they never cut normal operation but do stop a runaway retry loop.
# MODAL_BUDGET_USD_DAILY=1.0
# MODAL_BUDGET_USD_MONTHLY=10.0
# MODAL_COOLDOWN_MINUTES=30
# MODAL_MAX_CONCURRENCY=1
# MODAL_MAX_AUDIO_SECONDS_PER_EPISODE=900
# MODAL_MAX_CHUNKS_PER_EPISODE=20
# MODAL_USD_PER_GPU_SECOND=0.000222
# MODAL_ESTIMATED_CHARS_PER_SECOND=17.5
# MODAL_ESTIMATED_RTF=0.65
# MODAL_BUDGET_ALERT_PERCENT=[50,80,100]
# Narration audio lives outside tts_cache so WAV/M4A files and their
# .meta.json sidecars cannot collide with the digest TTS cache.
# NARRATION_CACHE_DIR=data/narration
# Local music library (files are never downloaded at runtime).
# NARRATION_MUSIC_DIR=data/narration/music
# NARRATION_LANGUAGE=es
# NARRATION_SPEED=1.0
# NARRATION_PAUSE_MS=400
# The gateway does not chunk long text and caps concurrency, so requests are
# split client-side.
# NARRATION_MAX_CHARS_PER_REQUEST=1500
# NARRATION_MAX_CONCURRENCY=2
# The conversations strategy renders the whole dialogue in one gateway
# request; long requests risk timeouts on CPU, so the client splits them
# into blocks of at most this many characters. Cuts fall between turns,
# never inside a sentence.
# NARRATION_CONVERSATION_MAX_CHARS_PER_BLOCK=4000
# Hard cap on turns per block.
# NARRATION_CONVERSATION_MAX_TURNS_PER_BLOCK=10
# A trailing block with fewer turns than this is merged into the previous one.
# NARRATION_CONVERSATION_MIN_BLOCK_TURNS=2
# Retries per block (the conversations strategy has no Edge fallback).
# NARRATION_CONVERSATION_BLOCK_RETRIES=1
# The gateway has no server-side timeout; a long multi-turn conversation can
# take minutes on CPU.
# NARRATION_REQUEST_TIMEOUT=300
# Fall back to a direct Edge TTS call when the gateway fails.
# WARNING: when true, a cloned-voice narration failure silently substitutes
# a stock Edge voice, losing the custom voice. Set to false for podcasts
# that depend on cloned voices (e.g. gaming with Dwight/MichaelScott) so
# failures are visible and trigger the error notification.
# NARRATION_FALLBACK_TO_EDGE=true
# Fall back to Edge TTS for dialog/podcast renders (2+ voices or conversations).
# When false (default), a dialog render will fail with an alert instead of
# silently substituting both cloned voices with the same stock Edge voice.
# This setting OVERRIDES NARRATION_FALLBACK_TO_EDGE for dialog renders only.
# NARRATIONS_DIALOG_FALLBACK_TO_EDGE=false
# NARRATION_AUDIO_BITRATE_KBPS=64

# Admin web GUI (/ui) + admin REST API (/api/admin/*)
# Preferred: set ADMIN_USERNAME and ADMIN_PASSWORD_HASH (bcrypt).
# Generate hash with: python -c "import bcrypt; print(bcrypt.hashpw(b'password', bcrypt.gensalt()).decode())"
# Legacy: set ADMIN_API_TOKEN (single shared token) if username is not set.
# Leave both empty to keep the GUI locked (secure default).
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_API_TOKEN=

# Temporal Configuration
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=news-engine-task-queue
# The voice catalog runs in its own namespace. A Temporal activity executes in
# the namespace of the workflow that scheduled it, so the workflow, the
# store/status activities and the design activity all live here. Create it once
# with: temporal operator create namespace news-engine-voices
TEMPORAL_VOICES_NAMESPACE=news-engine-voices
# Phase 7.9b: podcast generation owns one namespace per backend. The digest
# stays in TEMPORAL_NAMESPACE and reaches the render through
# dispatch_narration_activity, which starts NarrationWorkflow in one of these.
# Create all three with ./scripts/create_namespaces.sh
TEMPORAL_PODCAST_LOCAL_NAMESPACE=news-engine-podcast-local
TEMPORAL_PODCAST_MODAL_NAMESPACE=news-engine-podcast-modal
# Polled by the GPU box: python -m src.workers.run_voice_worker --role design
VOICE_DESIGN_TASK_QUEUE=news-engine-voice-design-queue
# Polled by the server: python -m src.workers.run_voice_worker --role catalog
VOICE_CATALOG_TASK_QUEUE=news-engine-voice-catalog-queue
# Reference audio designed on the GPU box reaches the server over HTTP instead
# of through Temporal history (a full 24-voice batch exceeded the history
# limit). The design activity POSTs the WAV to
# {VOICE_STAGING_URL}/api/internal/voices/staged/{name}; the endpoint answers
# 503 while the key is empty, which keeps staging opt-in.
VOICE_STAGING_URL=http://localhost:8000
VOICE_STAGING_API_KEY=
# RSS_FEED_URLS is the fallback feed list for the implicit "default" collection
# when no collections.toml is present (see collections.toml.example).
RSS_FEED_URLS=["https://example.com/rss.xml"]
# Path to the multiple-collections config (see collections.toml.example)
COLLECTIONS_FILE=collections.toml
# How often (minutes) the config monitor checks collections.toml and
# re-registers the Temporal schedules when it changes.
COLLECTIONS_MONITOR_INTERVAL_MINUTES=5

# System monitoring (SystemMonitorWorkflow, schedule id `system-monitor`).
# Runs the monitor checks every N minutes; alerts are delivered through the
# configured channels and every run is recorded in SQLite + a JSONL log.
MONITOR_INTERVAL_MINUTES=15
# Retention window (days) for monitor events in the DB and the JSONL logs.
MONITOR_RETENTION_DAYS=3
MONITOR_LOG_RETENTION_DAYS=3
MONITOR_LOG_DIR=data/logs
# Channels for monitor alerts (JSON array): telegram | email | whatsapp.
# Default telegram. Leave [] to disable alerts (state still recorded).
MONITOR_NOTIFY_CHANNELS=["telegram"]
# Destination overrides for monitor alerts (fall back to TELEGRAM_CHAT_ID).
MONITOR_TELEGRAM_CHAT_ID=
MONITOR_EMAIL_RECIPIENTS=["jordias@msn.com"]
# Allowlisted E.164 numbers/group for monitor WhatsApp alerts.
# MONITOR_WHATSAPP_RECIPIENTS=[]
# MONITOR_WHATSAPP_GROUP_ID=
# Alert when free disk space (main server) drops below this percentage.
MONITOR_DISK_THRESHOLD_PERCENT=20
# Send a daily system health summary; alert on every run when enabled.
MONITOR_DAILY_SUMMARY=true
MONITOR_ALERT_ON_RUN=false
# TTS server disk probe: <TTS_API_BASE_URL>/<MONITOR_TTS_DISK_PATH>.
# MONITOR_TTS_DISK_PATH=disk
# Docker Engine socket for container health checks (read-only in the worker).
# Empty disables the container check.
MONITOR_DOCKER_SOCKET=/var/run/docker.sock
